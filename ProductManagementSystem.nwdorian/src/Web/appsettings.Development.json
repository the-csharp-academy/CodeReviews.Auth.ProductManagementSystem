{
    "Serilog": {
        "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.Seq"],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Information",
                "Microsoft.AspNetCore.StaticFiles": "Warning",
                "Microsoft.AspNetCore.StaticAssets": "Warning",
                "Microsoft.AspNetCore.Routing": "Warning",
                "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
                "System": "Warning"
            }
        },
        "WriteTo": [
            {
                "Name": "Console"
            },
            {
                "Name": "Seq",
                "Args": {
                    "serverUrl": "http://localhost:5341"
                }
            }
        ],
        "Enrich": ["FromLogContext"]
    },
    "ConnectionStrings": {
        "Default": "Server=localhost,1433;Database=gamesedge;User Id=sa;Password=Password123;Encrypt=false;TrustServerCertificate=true"
    },
    "Smtp": {
        "Host": "localhost",
        "Port": 1025,
        "EnableSsl": false,
        "FromAddress": "noreply@gamesedge.com",
        "FromName": "GamesEdge"
    }
}

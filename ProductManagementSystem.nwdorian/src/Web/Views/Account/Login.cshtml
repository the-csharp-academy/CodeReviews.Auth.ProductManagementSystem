@model UserLogin

@{
    ViewData["Title"] = "Login";
    ViewData["BodyClass"] = "login-page";
}

<div class="d-flex justify-content-center">
    <div class="card login-card">
        <div class="card-body">
            <h1 class="card-title">Login</h1>
            <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="form-group">
                    <label asp-for="Email" class="control-label"></label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Password" class="control-label"></label>
                    <input asp-for="Password" class="form-control" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <div class="form-group form-check mt-2">
                    <label class="form-check-label">
                        <input class="form-check-input" asp-for="RememberMe" />
                        @Html.DisplayNameFor(model => model.RememberMe)
                    </label>
                </div>
                <div class="form-group my-2">
                    <a asp-action="ForgotPassword">Forgot Password?</a>
                </div>
                <div class="form-group mb-2">
                    <input type="submit" value="Log In" class="btn btn-primary w-100" />
                </div>
                <div class="form-group text-center">
                    <p>Don't have an account? <a asp-action="Register">Register here!</a></p>
                </div>
            </form>

            <div class="card mt-3">
                <div class="card-body">
                    <p class="text-center">Want to explore first? Try a demo user!</p>
                    <div class="d-flex gap-2">
                        <form asp-action="AdminLogin" method="post" class="flex-fill">
                            <button type="submit" class="btn btn-secondary w-100">Admin</button>
                        </form>
                        <form asp-action="StaffLogin" method="post" class="flex-fill">
                            <button type="submit" class="btn btn-secondary w-100">Staff</button>
                        </form>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}